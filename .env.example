# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Choice-assistance model. "groq" (free tier) or "mock" for offline work.
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Authentication. Optional in development (a local-only fallback is used),
# but required when NODE_ENV=production. Generate a long random value, e.g.
# `openssl rand -base64 48`, and keep it in the host's secret store.
JWT_SECRET=
